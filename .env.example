# Copy to .env and edit. Every setting here has a working default, so an empty .env
# (or no .env at all) runs the project as shipped.

OLLAMA_URL   = "http://127.0.0.1:11434"

# Profile extraction: runs once at the end of an interview, accuracy over latency.
LLM_MODEL    = "qwen3:8b"
# Live interview questions. Must be a NON-thinking instruct model - a hybrid reasoning
# model with thinking suppressed leaks its bookkeeping into what the kiosk says aloud.
TURN_MODEL   = "qwen3:4b-instruct"

# Speech recognition. "auto" uses Apple Silicon's GPU via MLX when available and falls
# back to faster-whisper (CPU) elsewhere. Force with "mlx" or "faster-whisper".
STT_BACKEND       = "auto"
MLX_WHISPER_MODEL = "mlx-community/whisper-large-v3-mlx"
WHISPER_MODEL     = "small"   # faster-whisper (CPU) fallback only

# Speech. Hindi and Punjabi share the Hindi voice; Kokoro has no Punjabi one.
TTS_VOICE    = "af_heart"
TTS_VOICE_HI = "hf_alpha"
TTS_RATE     = 24000

# Emailing the finished resume to the candidate. Without these the kiosk still prints
# and saves it, and says so instead of claiming it was sent. Gmail needs an App Password,
# not your account password. Keep real values out of version control.
# SMTP_USER = "you@gmail.com"
# SMTP_PASS = "app password"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
