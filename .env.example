# Copy to .env and edit. Every setting here has a working default, so an empty .env
# (or no .env at all) runs the project as shipped.

OLLAMA_URL   = "http://127.0.0.1:11434"

# Where the language model runs. Leave OPENAI_BASE_URL empty to stay fully offline on
# Ollama; set it to any OpenAI-compatible server (vLLM, llama.cpp, LM Studio) to use that
# instead - a GPU box on the LAN answers an interview question in well under a second,
# where this Mac takes 2-7. The server must support response_format json_schema; the kiosk
# asks for structured output on every call.
# OPENAI_BASE_URL = "http://172.16.20.39:8000/v1"
# OPENAI_MODEL    = "Qwen/Qwen3-32B-AWQ"
# OPENAI_API_KEY  = ""          # most local servers need none
# OPENAI_TURN_MODEL = ""        # only if a second, smaller model serves the questions
# LLM_BACKEND     = "ollama"    # force a backend; otherwise the base URL above decides

# Ollama models, used when no OPENAI_BASE_URL is set.
# Profile extraction: runs once at the end of an interview, accuracy over latency.
LLM_MODEL    = "qwen3:8b"
# Live interview questions. Must be a NON-thinking instruct model - a hybrid reasoning
# model with thinking suppressed leaks its bookkeeping into what the kiosk says aloud.
TURN_MODEL   = "qwen3:4b-instruct"

# Speech recognition. "auto" uses Apple Silicon's GPU via MLX when available and falls
# back to faster-whisper (CPU) elsewhere. Force with "mlx" or "faster-whisper".
STT_BACKEND       = "auto"
MLX_WHISPER_MODEL = "mlx-community/whisper-large-v3-mlx"
WHISPER_MODEL     = "small"   # faster-whisper (CPU) fallback only

# Speech. Hindi and Punjabi share the Hindi voice; Kokoro has no Punjabi one.
TTS_VOICE    = "af_heart"
TTS_VOICE_HI = "hf_alpha"
TTS_RATE     = 24000

# Emailing the finished resume to the candidate. Without these the kiosk still prints
# and saves it, and says so instead of claiming it was sent. Gmail needs an App Password,
# not your account password. Keep real values out of version control.
# SMTP_USER = "you@gmail.com"
# SMTP_PASS = "app password"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"

# MongoDB. Optional: without it the kiosk still runs and keeps records on disk.
MONGO_URL = "mongodb://127.0.0.1:27017"
MONGO_DB  = "tepma"

# What the kiosk offers. Everything is off by default except the resume interview.
# ENABLE_DOCUMENTS    = 1   # ask "resume or a document?" and offer the document branch
# ENABLE_LEGACY_PAGES = 1   # developer pages (/manual, /auto, /test, /docs-assistant) and
#                           # their APIs. Unsafe on a public kiosk - see README "Security".

# Languages the interview model phrases questions in; the rest use fixed wording.
# Punjabi is excluded because the model's Gurmukhi was partly meaningless in testing.
# PHRASED_LANGUAGES = "en,hi"

# Extra hostnames the server will answer to, comma-separated, wildcards allowed. Only needed
# behind a tunnel or reverse proxy; `scripts/tepma.sh tunnel` sets it for you.
# ALLOWED_HOSTS = "*.trycloudflare.com"
